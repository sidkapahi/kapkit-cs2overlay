// Cloudflare Workers config for the site itself (static assets only — no
// server code). Workers Builds runs `npm run build` then `npx wrangler deploy`
// from the repo root, which reads this file. The API proxies have their own
// configs under worker/.
{
  "name": "kapkit-cs2overlay",
  "compatibility_date": "2026-09-01",
  "assets": {
    // Vite's build output: the customizer at / and the OBS overlay at /widget/.
    "directory": "./dist"
  },
  // Workers Logs: keep request and console logs (viewable under the Worker's
  // Observability tab in the Cloudflare dashboard).
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },
  // Required by `wrangler preview`, which Workers Builds runs for every
  // non-main branch. Empty because previews need no settings of their own
  // (the site has no runtime vars or bindings; VITE_* values are build-time).
  "previews": {}
}
